# Supabase（复制为 .env 并填入真实值）
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# OAuth 回调公网地址（ngrok / 生产域名；本地可留空）
# PUBLIC_SITE_URL=https://your-domain.com
#
# Supabase Dashboard → Authentication → URL Configuration：
#   Site URL: https://your-domain.com
#   Redirect URLs 白名单：
#     http://localhost:8080/api/auth/callback
#     https://your-domain.com/api/auth/callback
#
# 邮箱注册验证（Confirm signup 邮件模板）推荐链接：
#   <a href="{{ .SiteURL }}/auth/confirm?token_hash={{ .TokenHash }}&type=signup">
#     Confirm your email
#   </a>
# 或直接：{{ .SiteURL }}/api/auth/callback?token_hash={{ .TokenHash }}&type=signup
# Site URL 不要带尾部斜杠，避免生成 //auth/confirm
# 不要用 {{ .ConfirmationURL }}（会走 PKCE code 流程，换浏览器/设备会失败）
# 不要带 next=/onboarding/checkout 等本应用不存在的路径

# 密钥系统 — token / secret 只存引用，明文写入 Supabase Vault
SECRETS_PROVIDER=supabase_vault
# 本地纯离线调试可改为 env（进程内存 / .env 映射，重启会丢）
# SECRETS_PROVIDER=env

# Shopify
SHOPIFY_API_VERSION=2025-04
# Partners App Admin OAuth（全租户共用，不按客户存库）
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# 本地开发用 http://localhost:8080；线上必须使用 HTTPS 域名
# 同时用于商户 OAuth 与消费者 Customer Account API 回调：
#   /api/shopify/oauth/callback
#   /shopify/customer/callback
SHOPIFY_APP_HOST=http://localhost:8080
#
# Shopify 后台 → Sales channels → Headless → Customer Account API settings：
#   Credentials: UUID 格式的 Client ID / Secret（不是 Partners App 的 32 位 Admin Client ID）
#   Callback URL: {SHOPIFY_APP_HOST}/shopify/customer/callback
#   Javascript origins: {SHOPIFY_APP_HOST 的 origin}
# 凭据保存在 Brand Config → Customer Account API 区块

# 消费者 OAuth 登录成功后允许回跳的外部 origin（逗号分隔；开发环境默认允许 localhost）
# CONSUMER_REDIRECT_ALLOWED_ORIGINS=http://localhost:5173,https://your-brand-app.com

# Klaviyo OAuth App 凭证（服务端环境变量，不按租户存库）
# KLAVIYO_CLIENT_ID=
# KLAVIYO_CLIENT_SECRET=
# KLAVIYO_OAUTH_REDIRECT_URI=https://your-host/api/klaviyo/callback

# 服务
PORT=8080
NODE_ENV=development
DEFAULT_CUSTOMER_ID=1

# 内部服务调用密钥（Magnet 发券、sample-proposal 签发 Dashboard magic link 等 M2M 接口；生产必填）
# POST /api/auth/impersonate-link  Body: { "email": "...", "next": "/" }
# 请求头: X-API-Key: <key> 或 Authorization: Bearer <key>
API_KEY=

# SECRETS_PROVIDER=env 时的本地映射（生产不要用）
# SHOPIFY_TOKEN_REF_1=shpat_xxxxxxxx
# SHOPIFY_WEBHOOK_SECRET_REF_1=whsec_xxxxxxxx
