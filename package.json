{
  "name": "dtc-dashboard",
  "version": "0.1.0",
  "private": true,
  "description": "FC DTC Dashboard — 品牌看板前端 + Shopify 发券服务",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "replay:order-payment": "tsx scripts/replay-order-payment.ts"
  },
  "engines": {
    "node": ">=25"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1070.0",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.49.8",
    "exceljs": "^4.4.0",
    "node-vibrant": "^4.0.4",
    "playwright": "^1.61.0",
    "sharp": "^0.35.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.21",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.1.4"
  }
}
